<Page x:Class="Win11Tweaker.UI.Pages.TaskbarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:local="clr-namespace:Win11Tweaker.UI.Controls"
      Title="Taskbar">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,24" MaxWidth="680">

            <!-- Page header -->
            <TextBlock Text="Taskbar" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="Customize the Windows 11 taskbar appearance and behavior."
                       FontSize="13"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,0,0,24" />

            <!-- ── Section: Quick Toggles ── -->
            <TextBlock Text="VISIBILITY" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,0,0,8" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <local:TweakRow Header="Search Button"
                                    Description="Show or hide the search button in the taskbar"
                                    IsToggled="{Binding ShowSearch, Mode=TwoWay}" />
                    <Separator Style="{StaticResource CardSeparatorStyle}" />
                    <local:TweakRow Header="Widgets Button"
                                    Description="Show or hide the Widgets (news &amp; interests) button"
                                    IsToggled="{Binding ShowWidgets, Mode=TwoWay}" />
                    <Separator Style="{StaticResource CardSeparatorStyle}" />
                    <local:TweakRow Header="Chat Button (Microsoft Teams)"
                                    Description="Show or hide the Teams / Chat button"
                                    IsToggled="{Binding ShowChat, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- ── Section: Layout ── -->
            <TextBlock Text="LAYOUT" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,20,0,8" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <local:TweakRow Header="Center Alignment"
                                    Description="Center taskbar icons (like macOS Dock). Disable for left alignment."
                                    IsToggled="{Binding CenterAligned, Mode=TwoWay}" />
                    <Separator Style="{StaticResource CardSeparatorStyle}" />
                    <local:TweakRow Header="Small Icons"
                                    Description="Use smaller taskbar icons to save space"
                                    IsToggled="{Binding SmallIcons, Mode=TwoWay}" />
                    <Separator Style="{StaticResource CardSeparatorStyle}" />
                    <local:TweakRow Header="Auto-hide Taskbar"
                                    Description="Hide taskbar when not in use, reveal on mouse hover"
                                    IsToggled="{Binding AutoHide, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- ── Section: Appearance ── -->
            <TextBlock Text="APPEARANCE" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,20,0,8" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <local:TweakRow Header="Dark Mode"
                                    Description="Switch between dark and light system theme"
                                    IsToggled="{Binding DarkMode, Mode=TwoWay}" />
                    <Separator Style="{StaticResource CardSeparatorStyle}" />
                    <local:TweakRow Header="Transparency Effects"
                                    Description="Enable Acrylic/Mica blur behind taskbar and other elements"
                                    IsToggled="{Binding Transparency, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- Restart notice -->
            <Border Margin="0,20,0,0" Padding="14,10"
                    Background="#1A0078D4" CornerRadius="6"
                    BorderBrush="#400078D4" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ️" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
                        Changes that affect the taskbar will automatically restart Explorer.
                        <LineBreak />You may see the taskbar briefly disappear — this is normal.
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
