<Page x:Class="Win11Tweaker.UI.Pages.AppearancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:local="clr-namespace:Win11Tweaker.UI.Controls"
      Title="Appearance">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,24" MaxWidth="680">

            <TextBlock Text="Appearance" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="Colors, accent, and visual style settings."
                       FontSize="13"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,0,0,24" />

            <TextBlock Text="ACCENT COLOR" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,0,0,8" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <!-- Color presets grid -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Preset Colors" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                    </StackPanel>

                    <ItemsControl x:Name="ColorPresets" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="32" Height="32" Margin="4"
                                        Click="ColorPreset_Click"
                                        Tag="{Binding}"
                                        ToolTip="{Binding}"
                                        Cursor="Hand">
                                    <Button.Background>
                                        <SolidColorBrush Color="{Binding}" />
                                    </Button.Background>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Root"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Width="32" Height="32">
                                                <Border.Effect>
                                                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.3" />
                                                </Border.Effect>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="CornerRadius" Value="6" />
                                                    <Setter TargetName="Root" Property="Width" Value="34" />
                                                    <Setter TargetName="Root" Property="Height" Value="34" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Style="{StaticResource CardSeparatorStyle}" />
                    <local:TweakRow Header="Show Accent Color on Taskbar &amp; Title Bars"
                                    Description="Apply your accent color to the taskbar and window title bars"
                                    IsToggled="{Binding ShowColorOnTaskbar, Mode=TwoWay}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
