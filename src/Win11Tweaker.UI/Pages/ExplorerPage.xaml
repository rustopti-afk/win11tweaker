<Page x:Class="Win11Tweaker.UI.Pages.ExplorerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:local="clr-namespace:Win11Tweaker.UI.Controls"
      Title="Explorer">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,24" MaxWidth="680">

            <TextBlock Text="File Explorer" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="Customize Windows Explorer behavior and appearance."
                       FontSize="13"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,0,0,24" />

            <TextBlock Text="MENUS &amp; BEHAVIOR" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,0,0,8" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <local:TweakRow Header="Restore Old Context Menu"
                                    Description="Skip 'Show more options' — show the full Win10 right-click menu directly"
                                    IsToggled="{Binding OldContextMenu, Mode=TwoWay}" />
                    <Separator Style="{StaticResource CardSeparatorStyle}" />
                    <local:TweakRow Header="Launch Explorer to This PC"
                                    Description="Open File Explorer showing This PC instead of Quick Access"
                                    IsToggled="{Binding LaunchToThisPC, Mode=TwoWay}" />
                    <Separator Style="{StaticResource CardSeparatorStyle}" />
                    <local:TweakRow Header="Compact Mode"
                                    Description="Reduce row height in Explorer for a more compact look"
                                    IsToggled="{Binding CompactMode, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <TextBlock Text="FILE VISIBILITY" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,20,0,8" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <local:TweakRow Header="Show File Extensions"
                                    Description="Always display file extensions (e.g. .txt, .exe, .jpg)"
                                    IsToggled="{Binding ShowExtensions, Mode=TwoWay}" />
                    <Separator Style="{StaticResource CardSeparatorStyle}" />
                    <local:TweakRow Header="Show Hidden Files"
                                    Description="Reveal hidden files and folders (AppData, System files)"
                                    IsToggled="{Binding ShowHiddenFiles, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <TextBlock Text="DESKTOP" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,20,0,8" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <local:TweakRow Header="Show Desktop Icons"
                                    Description="Show or hide all icons on the desktop"
                                    IsToggled="{Binding DesktopIconsVisible, Mode=TwoWay}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
