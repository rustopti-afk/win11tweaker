<Page x:Class="Win11Tweaker.UI.Pages.ThemesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Title="Themes">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,24" MaxWidth="680">

            <TextBlock Text="Themes" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Apply system themes (.theme) or custom unsigned themes via SecureUxTheme."
                       FontSize="13"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,0,0,24"/>

            <!-- SecureUxTheme status -->
            <TextBlock Text="SECUREUX THEME" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,0,0,8"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Margin="0,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse x:Name="SutDot" Width="8" Height="8"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="SutStatus" FontSize="13" VerticalAlignment="Center"/>
                        <Button x:Name="InstallSutBtn" Content="Install SecureUxTheme"
                                Visibility="Collapsed" Margin="12,0,0,0"
                                Click="InstallSut_Click"
                                Style="{DynamicResource AccentButtonStyle}"/>
                    </StackPanel>
                    <TextBlock FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                        SecureUxTheme allows applying custom unsigned .msstyles themes
                        without patching system files.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Installed themes -->
            <TextBlock Text="INSTALLED THEMES" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,20,0,8"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Margin="0,8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                        <Button Content="📁 Install Custom Theme (.msstyles)"
                                Click="InstallTheme_Click"
                                Style="{DynamicResource AccentButtonStyle}"/>
                        <Button Content="🔄 Refresh" Click="RefreshThemes_Click"/>
                    </StackPanel>

                    <ItemsControl x:Name="ThemesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Preview thumbnail -->
                                    <Border Grid.Column="0" Width="48" Height="36"
                                            CornerRadius="4"
                                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                                        <Image Source="{Binding PreviewPath}" Stretch="UniformToFill"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Path}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="Apply"
                                            Tag="{Binding Path}"
                                            Click="ApplyTheme_Click"
                                            Style="{DynamicResource AccentButtonStyle}"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
