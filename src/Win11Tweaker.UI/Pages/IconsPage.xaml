<Page x:Class="Win11Tweaker.UI.Pages.IconsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Title="Icons">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,24" MaxWidth="680">

            <TextBlock Text="Icon Packs" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Install and apply custom icon packs (.zip with manifest.json)."
                       FontSize="13"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,0,0,24"/>

            <!-- Install pack -->
            <TextBlock Text="INSTALL PACK" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,0,0,8"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Margin="0,8">
                    <TextBlock TextWrapping="Wrap" FontSize="13" Margin="0,0,0,12">
                        Icon packs are <Bold>.zip</Bold> files containing an <Bold>manifest.json</Bold>
                        and icon files (.ico, .png). Drop a ZIP here or click Browse.
                    </TextBlock>

                    <Border x:Name="DropZone" Height="80" CornerRadius="6"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            BorderThickness="2" Background="Transparent"
                            AllowDrop="True"
                            DragEnter="DropZone_DragEnter"
                            DragLeave="DropZone_DragLeave"
                            Drop="DropZone_Drop"
                            Margin="0,0,0,10">
                        <TextBlock Text="Drop icon pack .zip here"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </Border>

                    <Button Content="📁 Browse Icon Pack ZIP..."
                            Click="BrowseIconPack_Click"
                            Style="{DynamicResource AccentButtonStyle}"/>
                </StackPanel>
            </Border>

            <!-- Installed packs list -->
            <TextBlock Text="INSTALLED PACKS" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,20,0,8"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <ItemsControl x:Name="PacksList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Preview icon -->
                                    <Border Grid.Column="0" Width="40" Height="40"
                                            CornerRadius="4"
                                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                                        <Image Source="{Binding PreviewPath}" Stretch="Uniform"
                                               Width="32" Height="32"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Dir}" FontSize="11"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="Apply"
                                            Tag="{Binding}"
                                            Click="ApplyPack_Click"
                                            Style="{DynamicResource AccentButtonStyle}"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="NoPacksText"
                               Text="No icon packs installed yet. Browse or drop a ZIP above."
                               FontSize="13" Margin="0,12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
            </Border>

            <!-- Custom folder icon -->
            <TextBlock Text="CUSTOM FOLDER ICON" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,20,0,8"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Margin="0,10">
                    <TextBlock FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10">
                        Apply a custom icon to a specific folder via Desktop.ini
                    </TextBlock>
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="📂 Choose Folder..." Click="ChooseFolder_Click"/>
                        <Button Content="🖼️ Choose Icon..."   Click="ChooseIcon_Click"/>
                        <Button Content="Apply" Click="ApplyFolderIcon_Click"
                                Style="{DynamicResource AccentButtonStyle}"
                                x:Name="ApplyFolderBtn" IsEnabled="False"/>
                    </ui:SimpleStackPanel>
                    <TextBlock x:Name="FolderStatusText" FontSize="12" Margin="0,8,0,0"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
