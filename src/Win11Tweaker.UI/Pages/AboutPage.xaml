<Page x:Class="Win11Tweaker.UI.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="About">

    <StackPanel Margin="32,24" MaxWidth="680">
        <TextBlock Text="About" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,24" />

        <Border Style="{StaticResource CardStyle}">
            <StackPanel Margin="0,12">
                <TextBlock Text="Win11 Tweaker" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Version 0.1.0 — Phase 1 MVP" FontSize="13"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           Margin="0,4,0,16" />

                <TextBlock TextWrapping="Wrap" FontSize="13">
                    A Windows 11 customization tool. Safely tweak the taskbar,
                    Explorer, appearance, and more — with full undo support.
                </TextBlock>

                <Separator Margin="0,16" />

                <TextBlock Text="Every change is backed up automatically. Use ↩ Undo to revert."
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
