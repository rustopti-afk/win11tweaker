<Page x:Class="Win11Tweaker.UI.Pages.ToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Title="Tools">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,24" MaxWidth="680">

            <TextBlock Text="Tools" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Manage Rainmeter skins and Windhawk mods."
                       FontSize="13"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,0,0,24"/>

            <!-- ── Rainmeter ── -->
            <TextBlock Text="RAINMETER" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,0,0,8"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Margin="0,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse x:Name="RmDot" Width="8" Height="8"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="RmStatus" FontSize="13" VerticalAlignment="Center"/>
                        <Button x:Name="InstallRmBtn" Content="Install via winget"
                                Visibility="Collapsed" Margin="12,0,0,0"
                                Click="InstallRainmeter_Click"
                                Style="{DynamicResource AccentButtonStyle}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                        <Button Content="📁 Install Skin (.rmskin)" Click="InstallSkin_Click"/>
                        <Button Content="🚀 Launch Rainmeter" Click="LaunchRainmeter_Click"
                                x:Name="LaunchRmBtn" IsEnabled="False"/>
                    </StackPanel>

                    <!-- Installed skins list -->
                    <TextBlock Text="Installed Skins:" FontSize="12" FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <ItemsControl x:Name="SkinsList" MaxHeight="200">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Activate" Margin="4,0"
                                            Tag="{Binding}"
                                            Click="ActivateSkin_Click" FontSize="11"/>
                                    <Button Grid.Column="2" Content="Deactivate"
                                            Tag="{Binding ConfigName}"
                                            Click="DeactivateSkin_Click" FontSize="11"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ── Windhawk ── -->
            <TextBlock Text="WINDHAWK" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,20,0,8"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Margin="0,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse x:Name="WhDot" Width="8" Height="8"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="WhStatus" FontSize="13" VerticalAlignment="Center"/>
                        <Button x:Name="InstallWhBtn" Content="Install via winget"
                                Visibility="Collapsed" Margin="12,0,0,0"
                                Click="InstallWindhawk_Click"
                                Style="{DynamicResource AccentButtonStyle}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                        <Button Content="🚀 Launch Windhawk" Click="LaunchWindhawk_Click"
                                x:Name="LaunchWhBtn" IsEnabled="False"/>
                        <Button Content="🔄 Refresh Mods" Click="RefreshMods_Click"/>
                    </StackPanel>

                    <!-- Recommended mods -->
                    <TextBlock Text="Recommended Mods:" FontSize="12" FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <ItemsControl x:Name="ModsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding IsInstalled, Converter={StaticResource BoolToColorConverter}}"/>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Margin="6,0"
                                            Content="{Binding IsInstalled, Converter={StaticResource BoolToInstallTextConverter}}"
                                            Tag="{Binding}"
                                            Click="ToggleMod_Click"
                                            VerticalAlignment="Center"/>

                                    <Button Grid.Column="2" Content="🌐"
                                            ToolTip="Open mod page in browser"
                                            Tag="{Binding Id}"
                                            Click="OpenModPage_Click"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
