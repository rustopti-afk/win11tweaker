<Page x:Class="Win11Tweaker.UI.Pages.WallpaperPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:local="clr-namespace:Win11Tweaker.UI.Controls"
      Title="Wallpaper">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,24" MaxWidth="680">

            <TextBlock Text="Wallpaper" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Set static images or animated wallpapers via Lively Wallpaper."
                       FontSize="13"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,0,0,24"/>

            <!-- ── Static Wallpaper ── -->
            <TextBlock Text="STATIC IMAGE" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,0,0,8"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Margin="0,8">

                    <!-- Preview -->
                    <Border x:Name="WallpaperPreview"
                            Height="160" CornerRadius="4" Margin="0,0,0,12"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                        <Image x:Name="PreviewImage" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button Content="📁 Browse Image..."
                                Click="BrowseWallpaper_Click"
                                Style="{DynamicResource AccentButtonStyle}" />
                        <Button Content="🎨 Solid Color..."
                                Click="SolidColor_Click" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Style:" VerticalAlignment="Center" Margin="0,0,12,0"
                                   FontSize="13"/>
                        <ui:RadioButtons x:Name="StyleRadio" MaxColumns="6"
                                         SelectionChanged="StyleRadio_Changed">
                            <RadioButton Content="Fill"    Tag="Fill"    IsChecked="True"/>
                            <RadioButton Content="Fit"     Tag="Fit"/>
                            <RadioButton Content="Stretch" Tag="Stretch"/>
                            <RadioButton Content="Tile"    Tag="Tile"/>
                            <RadioButton Content="Center"  Tag="Center"/>
                            <RadioButton Content="Span"    Tag="Span"/>
                        </ui:RadioButtons>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Animated Wallpaper (Lively) ── -->
            <TextBlock Text="ANIMATED WALLPAPER" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,20,0,8"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Margin="0,8">

                    <!-- Lively status badge -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Ellipse x:Name="LivelyStatusDot" Width="8" Height="8" Margin="0,0,8,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="LivelyStatusText" FontSize="13"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="InstallLivelyBtn" Content="Install Lively"
                                Visibility="Collapsed" Margin="12,0,0,0"
                                Click="InstallLively_Click"
                                Style="{DynamicResource AccentButtonStyle}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="🎬 Set Video / GIF Wallpaper..."
                                Click="BrowseLively_Click"
                                x:Name="BrowseLivelyBtn" IsEnabled="False"/>
                        <Button Content="⏹ Stop Animated Wallpaper"
                                Click="StopLively_Click"
                                x:Name="StopLivelyBtn" IsEnabled="False"/>
                    </StackPanel>

                    <TextBlock Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               Text="Supports: MP4, GIF, HTML, YouTube URLs, and Shadertoy shaders." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
