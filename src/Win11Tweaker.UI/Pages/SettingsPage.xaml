<Page x:Class="Win11Tweaker.UI.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Title="Settings">

    <StackPanel Margin="32,24" MaxWidth="680">
        <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Text="App preferences and backup options."
                   FontSize="13"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   Margin="0,0,0,24" />

        <TextBlock Text="APP THEME" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   Margin="0,0,0,8" />

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10">
                    <TextBlock Text="App Theme" FontSize="14" VerticalAlignment="Center"
                               Margin="0,0,16,0" />
                    <ui:RadioButtons x:Name="ThemeRadio" SelectionChanged="ThemeRadio_Changed">
                        <RadioButton Content="Dark" Tag="Dark" IsChecked="True" />
                        <RadioButton Content="Light" Tag="Light" />
                        <RadioButton Content="System Default" Tag="Default" />
                    </ui:RadioButtons>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="BACKUP" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   Margin="0,20,0,8" />

        <Border Style="{StaticResource CardStyle}">
            <StackPanel Margin="0,8">
                <TextBlock Text="Backups are saved automatically before each change."
                           FontSize="13"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           Margin="0,0,0,12" />
                <Button Content="Open Backup Folder" Click="OpenBackupFolder_Click"
                        Style="{DynamicResource DefaultButtonStyle}" />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
