<Page x:Class="Win11Tweaker.UI.Pages.FontsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:local="clr-namespace:Win11Tweaker.UI.Controls"
      Title="Fonts">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,24" MaxWidth="680">

            <TextBlock Text="Fonts" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Install custom fonts and replace the system UI font."
                       FontSize="13"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,0,0,24"/>

            <!-- Install font -->
            <TextBlock Text="INSTALL FONT" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,0,0,8"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Margin="0,8">
                    <Border x:Name="FontDropZone" Height="70" CornerRadius="6"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            BorderThickness="2" Background="Transparent"
                            AllowDrop="True"
                            DragEnter="FontDrop_DragEnter"
                            DragLeave="FontDrop_DragLeave"
                            Drop="FontDrop_Drop"
                            Margin="0,0,0,10">
                        <TextBlock Text="Drop .ttf / .otf files here"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </Border>
                    <Button Content="📁 Browse Font File..."
                            Click="BrowseFont_Click"
                            Style="{DynamicResource AccentButtonStyle}"/>
                </StackPanel>
            </Border>

            <!-- Replace system font -->
            <TextBlock Text="REPLACE SYSTEM FONT (Segoe UI)" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,20,0,8"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Margin="0,10">
                    <TextBlock TextWrapping="Wrap" FontSize="13" Margin="0,0,0,10">
                        Replace <Bold>Segoe UI</Bold> with any installed font.
                        Affects menus, title bars, and most system UI. Requires restart.
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                        <ComboBox x:Name="SystemFontPicker" Width="220"
                                  SelectionChanged="SystemFontPicker_Changed"/>
                        <Button Content="Apply Font" Click="ApplySystemFont_Click"
                                Style="{DynamicResource AccentButtonStyle}"
                                x:Name="ApplyFontBtn" IsEnabled="False"/>
                        <Button Content="Restore Default" Click="RestoreDefaultFont_Click"/>
                    </StackPanel>

                    <!-- Preview -->
                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                            CornerRadius="4" Padding="12,8">
                        <TextBlock x:Name="FontPreviewText"
                                   Text="The quick brown fox jumps over the lazy dog  0123456789"
                                   FontSize="15" TextWrapping="Wrap"/>
                    </Border>

                    <Border Margin="0,10,0,0" Padding="10,8"
                            Background="#1AFFD700" CornerRadius="4"
                            BorderBrush="#40FFD700" BorderThickness="1">
                        <TextBlock FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
                            ⚠️ A restart is required for the font change to apply to all windows.
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
