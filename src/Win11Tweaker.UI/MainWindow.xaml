<Window x:Class="Win11Tweaker.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:pages="clr-namespace:Win11Tweaker.UI.Pages"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Win11 Tweaker"
        Width="960" Height="640"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Sidebar ─────────────────────────────────────────────── -->
        <Border Grid.Column="0"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,1,0">

            <DockPanel>
                <!-- App header -->
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,16">
                    <TextBlock Text="Win11 Tweaker"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                    <TextBlock Text="v0.1.0 — Phase 1 MVP"
                               FontSize="11"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- Nav items -->
                <StackPanel DockPanel.Dock="Top" Margin="8,0">
                    <Button x:Name="BtnTaskbar"    Style="{StaticResource NavButtonStyle}"
                            Content="⬛  Taskbar"     Click="NavButton_Click" Tag="Taskbar" />
                    <Button x:Name="BtnExplorer"   Style="{StaticResource NavButtonStyle}"
                            Content="📁  Explorer"    Click="NavButton_Click" Tag="Explorer" />
                    <Button x:Name="BtnAppearance"  Style="{StaticResource NavButtonStyle}"
                            Content="🎨  Appearance"  Click="NavButton_Click" Tag="Appearance" />
                    <Button x:Name="BtnIcons"       Style="{StaticResource NavButtonStyle}"
                            Content="🖼️  Icons"       Click="NavButton_Click" Tag="Icons" />
                    <Button x:Name="BtnFonts"       Style="{StaticResource NavButtonStyle}"
                            Content="🔤  Fonts"       Click="NavButton_Click" Tag="Fonts" />
                    <Button x:Name="BtnWallpaper"   Style="{StaticResource NavButtonStyle}"
                            Content="🖥️  Wallpaper"   Click="NavButton_Click" Tag="Wallpaper" />
                </StackPanel>

                <!-- Separator -->
                <Separator DockPanel.Dock="Top" Margin="16,12" />

                <!-- Bottom nav -->
                <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,12">
                    <Button x:Name="BtnSettings" Style="{StaticResource NavButtonStyle}"
                            Content="⚙️  Settings" Click="NavButton_Click" Tag="Settings" />
                    <Button x:Name="BtnAbout"    Style="{StaticResource NavButtonStyle}"
                            Content="ℹ️  About"    Click="NavButton_Click" Tag="About" />
                </StackPanel>

                <!-- Undo/rollback controls -->
                <Border DockPanel.Dock="Bottom" Margin="12,0,12,8"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                        CornerRadius="6" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Recent Changes"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   Margin="0,0,0,6" />
                        <Button Content="↩ Undo Last"
                                HorizontalAlignment="Stretch"
                                Click="UndoLast_Click"
                                Style="{DynamicResource DefaultButtonStyle}"
                                Margin="0,0,0,4" />
                        <Button Content="🔄 Undo All"
                                HorizontalAlignment="Stretch"
                                Click="UndoAll_Click"
                                Style="{DynamicResource DefaultButtonStyle}" />
                    </StackPanel>
                </Border>

                <Grid /> <!-- spacer -->
            </DockPanel>
        </Border>

        <!-- ── Content area ────────────────────────────────────────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Page frame -->
            <Frame x:Name="ContentFrame" Grid.Row="0"
                   NavigationUIVisibility="Hidden" />

            <!-- Status bar -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusText"
                               Grid.Column="0"
                               Text="Ready"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="ChangesCount"
                                   Text="0 changes"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
